APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# نگهداشت سبدهای مهمان — carts:prune-guests (روزانه ۰۱:۳۰)
CART_GUEST_RETENTION_DAYS=30
CART_PRUNE_CHUNK=1000
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD="your_mail_password"
MAIL_FROM_ADDRESS=your_mail_from_address
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


PODIUM_BASE_URL=https://api.pod.ir
PODIUM_BUSINESS_TOKEN=your_podium_business_token_here
PODIUM_SC_API_KEY_SETTLEMENT="your_podium_sc_api_key_settlement_here"
PODIUM_SC_API_KEY_BALANCES="your_podium_sc_api_key_balances_here"
PODIUM_SC_API_KEY_BATCH="your_podium_sc_api_key_batch_here"
PODIUM_SC_API_KEY_INQUIRY="your_podium_sc_api_key_inquiry_here"
PODIUM_SC_PRODUCT_ID_IDENTITY_INQUIRY=your_product_id_here
PODIUM_SC_API_KEY_IDENTITY_INQUIRY=your_podium_sc_api_key_identity_inquiry_here
PODIUM_SC_PRODUCT_ID_MATCH_MOBILE_NID=your_product_id_here
PODIUM_SC_API_KEY_MATCH_MOBILE_NID=your_podium_sc_api_key_match_mobile_nid_here
PODIUM_SC_API_KEY_SHEBA="your_podium_sc_api_key_sheba_here"
PODIUM_SC_PRODUCT_ID_SHEBA=your_product_id_here
PODIUM_SC_API_KEY_CARD="your_podium_sc_api_key_card_here"
PODIUM_SC_PRODUCT_ID_CARD=your_product_id_here

# استعلام شرکت (CompanyInquiryService) — تا پیش از این در این فایل نبود، و
# کلیدش تنها موردی بود که به‌جای اینجا در فالبکِ `env()` زندگی می‌کرد. آن فالبک
# در 0d30c06 حذف شد و کلید در پنل پادیوم تعویض می‌شود؛ اینجا فقط placeholder.
PODIUM_SC_API_KEY_COMPANY=your_podium_sc_api_key_company_here
PODIUM_SC_PRODUCT_ID_COMPANY=your_product_id_here

# کارت به شبا (CardToIbanService)
PODIUM_SC_API_KEY_CARD_TO_IBAN=your_podium_sc_api_key_card_to_iban_here
PODIUM_SC_PRODUCT_ID_CARD_TO_IBAN=your_product_id_here

# تسویه (PodiumWithdrawalService) — بدون این دو، isConfigured() برابر false
# می‌ماند و تسویه غیرفعال است.
PODIUM_SETTLEMENT_SC_API_KEY=your_podium_settlement_sc_api_key_here
PODIUM_SETTLEMENT_SC_PRODUCT_ID=your_product_id_here

PODIUM_BUSINESS_ID=your_podium_business_id_here
PODIUM_USER_ID=your_podium_user_id_here
PODIUM_SSO_ID=your_podium_sso_id_here
PODIUM_SC_29798=your_podium_sc_29798_here

PODIUM_SC_PRODUCT_INVOICE_CREATE=your_product_id_here
PODIUM_SC_INVOICE_CREATE=your_podium_sc_invoice_create_here

# ── واریز مستقیم بانکی: صورت‌حساب سپرده ──────────────────────────────────
# همه اختیاری‌اند؛ نبودشان یعنی پیش‌فرضِ config/podium.php.
#
# TIMEZONE مهم‌ترینشان است: app.timezone روی UTC است و تاریخ/ساعتی که به بانک
# می‌رود باید محلی باشد، وگرنه پنجرهٔ polling ۳٫۵ ساعت عقب می‌افتد و شارژِ
# کیف پول همان‌قدر تأخیر می‌گیرد.
PODIUM_STATEMENT_TIMEZONE=Asia/Tehran
# اندازهٔ هر صفحه و سقفِ صفحه — بانک واریز و برداشت را با هم می‌دهد، پس یک صفحهٔ
# کوچک می‌تواند واریزهای واقعی را پشتِ برداشت‌ها پنهان کند.
PODIUM_STATEMENT_PAGE_SIZE=100
PODIUM_STATEMENT_MAX_PAGES=500
# هم‌پوشانیِ عمدی روی هر اجرا (تکرار بی‌خطر است — doc_number ایندکسِ یکتا دارد)
PODIUM_STATEMENT_OVERLAP_MINUTES=5
# پنجرهٔ اولین اجرا، وقتی هنوز watermarkی ثبت نشده
PODIUM_STATEMENT_DEFAULT_WINDOW_MINUTES=15
# سقفِ عقبگرد پس از یک قطعیِ طولانی (۷ روز) — تا «کلِ تاریخ» از بانک خواسته نشود
PODIUM_STATEMENT_MAX_LOOKBACK_MINUTES=10080

TESNA_BASE_URL=https://gateway.tesna.ir
TESNA_API_KEY=your_tesna_api_key_here
TESNA_BEARER_TOKEN="your_tesna_bearer_token_here"


# ── حساب سپرده شناسه‌دار (واریز مستقیم بانکی — شناسه واریز) ──────────────────
PODIUM_DEPOSIT_NUMBER="your_deposit_number_here"
PODIUM_DEPOSIT_SC_API_KEY="your_deposit_sc_api_key_here"
PODIUM_DEPOSIT_ENTITY_ID="your_deposit_entity_id_here"
PODIUM_DEPOSIT_IBAN="your_iban_here"
PODIUM_DEPOSIT_BANK_NAME="your_bank_name_here"
PODIUM_DEPOSIT_ACCOUNT_HOLDER="your_account_holder_name_here"

PODIUM_BUSINESS_ID=your_podium_business_id_here
PODIUM_USER_ID=your_podium_user_id_here

# ── کیف‌پول سیستم (سازه) ────────────────────────────────────────────────────
FINANCIAL_SYSTEM_USER_ID=your_financial_system_user_id_here
PODIUM_SSO_ID=your_podium_sso_id_here
PODIUM_SC_29798=your_podium_sc_29798_here

PODIUM_SC_PRODUCT_INVOICE_CREATE=your_product_id_here
PODIUM_SC_INVOICE_CREATE=your_podium_sc_invoice_create_here


TESNA_BASE_URL=https://gateway.tesna.ir
TESNA_API_KEY=your_tesna_api_key_here
TESNA_BEARER_TOKEN="your_tesna_bearer_token_here"


TSMS_LINK=https://tsms.ir/url/tsmshttp.php
TSMS_NUMBER=your_tsms_number_here
TSMS_USERNAME=your_tsms_username_here
TSMS_PASSWORD=your_tsms_password_here
# پنجرهٔ ضدِ ارسالِ پیامکِ تکراری (ثانیه) — باید کوچک‌تر از اولین backoffِ صف بماند.
TSMS_DEDUPE_WINDOW_SECONDS=25

# ── OTP / Idempotency ────────────────────────────────────────────────────
# کدِ ثابتِ OTP فقط در محیطِ غیرپروداکشن استفاده می‌شود (staging/local) تا تسترها
# بدونِ پیامک وارد شوند؛ در production همیشه کدِ تصادفیِ امن تولید می‌شود.
OTP_DEBUG_CODE=111111
# پنجرهٔ اثرانگشتیِ ضدِ دابل‌سابمیت روی مسیرهای مالی وقتی هدر Idempotency-Key ارسال نشود (ثانیه).
IDEMPOTENCY_FINGERPRINT_WINDOW=10

# ── Sentry ───────────────────────────────────────────────────────────────
# روی مارکت‌پلیسی با کارت/شبا/کدملی، دادهٔ حساسِ درخواست/کوکی/هدر نباید به Sentry برود.
# false بماند (پیش‌فرضِ امن)؛ فقط در دیباگِ کوتاه‌مدت true شود.
SENTRY_SEND_DEFAULT_PII=false

DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
DISABLE_BUG_COMMAND=1
CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1


# ── فضای ذخیره‌سازی فایل‌های عمومی ────────────────────────────────────────
# پیش‌فرض local است (storage/app/public + storage:link) تا نصب تازه/CI بدون
# اعتبارنامه‌ی ابری کار کند. برای آروان‌کلود/S3 مقدار را s3 کنید و AWS_* بالا
# را پر کنید (قرارداد کامل: .env.cloud.example).
FILESYSTEM_PUBLIC_DRIVER=local
# FILESYSTEM_PUBLIC_DRIVER=s3
# AWS_DEFAULT_REGION=ir-thr-at1
# AWS_PUBLIC_BUCKET=your_aws_public_bucket_here
# AWS_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# ── Sentry error tracking (خالی = غیرفعال) ────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── محدودیت IP پنل ادمین (خالی = غیرفعال؛ IP یا CIDR، جداشده با کاما) ─────
ADMIN_IP_WHITELIST=

# ── درگاه پرداخت پاسارگاد ─────────────────────────────────────────────────
# تا وقتی هر سه‌ی این‌ها پر نشوند، `PasargadGateway::isConfigured()` برابر
# false است و درگاه fail-safe می‌ماند (هیچ‌وقت crash نمی‌کند و هرگز اعتبارِ
# ساختگی واریز نمی‌کند). این عمدی است — طبق سند، کردنشیال پس از راه‌اندازی
# وبسایت می‌آید.
PASARGAD_MERCHANT_ID=
PASARGAD_TERMINAL_ID=
PASARGAD_API_KEY=
