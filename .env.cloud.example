# ─────────────────────────────────────────────────────────────────────────────
# ArvanCloud / S3-compatible object storage for user uploads
# ─────────────────────────────────────────────────────────────────────────────
# Leave everything below UNSET to keep uploads on the server's local disk (the
# default — dev & current staging). To move uploads to ArvanCloud, set the two
# *_DRIVER vars to `s3` and fill the credentials. NO application code changes are
# needed: every upload uses Storage::disk('public'|'financial'|'local'), and all
# public URLs are built via Storage::url(), so flipping the driver is enough.
#
# Arvan Object Storage is S3-compatible, so the built-in `s3` driver works.
# (league/flysystem-aws-s3-v3 is already installed.)

# 1) Flip uploads to the cloud:
FILESYSTEM_PUBLIC_DRIVER=s3        # media   : avatars, product/badge/category/factory images, ticket files
FILESYSTEM_PRIVATE_DRIVER=s3       # private : financial receipts, invoice PDFs, job-experience documents

# 2) Arvan credentials + endpoint:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ir-thr-at1                          # your Arvan region
AWS_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir     # your Arvan endpoint
AWS_USE_PATH_STYLE_ENDPOINT=false                      # set true if the bucket needs path-style URLs

# 3) Buckets — two recommended (public-read media + private documents):
AWS_PUBLIC_BUCKET=elitezone-media
AWS_PRIVATE_BUCKET=elitezone-docs
# (single-bucket setups: set AWS_BUCKET and both fall back to it)
AWS_BUCKET=

# 4) Public base URL for media (the public bucket's CDN / endpoint URL):
FILESYSTEM_PUBLIC_URL=https://elitezone-media.s3.ir-thr-at1.arvanstorage.ir

# 5) Optional object-key prefixes inside each bucket (defaults shown):
# FILESYSTEM_PUBLIC_ROOT=
# FILESYSTEM_FINANCIAL_ROOT=financial
# FILESYSTEM_LOCAL_ROOT=documents

# ─────────────────────────────────────────────────────────────────────────────
# One-time cutover for a server that ALREADY has local uploads:
#   php artisan storage:migrate-to-cloud --dry-run   # preview
#   php artisan storage:migrate-to-cloud             # copy local files → cloud
# ─────────────────────────────────────────────────────────────────────────────
