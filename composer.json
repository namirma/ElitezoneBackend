{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-iconv": "*",
        "artisaninweb/laravel-soap": "0.3.0.10",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "guzzlehttp/guzzle": "^7.9",
        "hekmatinasser/verta": "^8.3",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.35",
        "minishlink/web-push": "^11.0",
        "predis/predis": "^3.5",
        "santigarcor/laratrust": "^8.2",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "8.8",
        "symfony/css-selector": "^7.2",
        "symfony/dom-crawler": "^7.2",
        "symfony/http-client": "^7.2",
        "visus/cuid2": "^4.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.1",
        "dedoc/scramble": "0.13.28",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^2.11",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Http/Helper/function.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models --nowrite",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Laravel signed-URL path confusion. Fixed in >=12.61.1 only. This branch is pinned to Laravel 10 by supervisor decision (2026-08-08); re-evaluate when the L13 branch ships.",
                "PKSA-3r5d-mb8f-1qw9": "Laravel CRLF injection in the default email rule. Fixed in >=12.60.0 only. Same Laravel-10 pin as above.",
                "CVE-2026-48019": "Duplicate of PKSA-3r5d-mb8f-1qw9 under a CVE id. Same Laravel-10 pin as above."
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
